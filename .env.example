# Copia este archivo a .env y ajusta los valores. .env nunca se sube a git.

# Postgres local (docker-compose)
POSTGRES_USER=ldr
POSTGRES_PASSWORD=ldr
POSTGRES_DB=ldr
POSTGRES_PORT=5433

# Lo que usa la app para conectarse
DATABASE_URL=postgresql://ldr:ldr@localhost:5433/ldr

# Google AI Studio (se usa desde la fase 3)
GEMINI_API_KEY=
